# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the app on loopback.
# It overwrites X-Forwarded-For with the real client IP, which the app trusts
# only because the request arrives from 127.0.0.1.
{DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header -Server
	reverse_proxy 127.0.0.1:8080
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}

# Bare IP / unknown hosts get nothing.
:80 {
	respond 404
}
